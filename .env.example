# Automaton — local hardware configuration.
# Copy to .env and edit. Every value here has a working default except the
# genesis prompt, which is the one thing only you can write.

# ─── Identity and purpose ─────────────────────────────────────────

AUTOMATON_NAME=automaton

# The seed instruction. This is what the agent is for. Be concrete: a vague
# genesis prompt produces an agent that spends every turn deciding what to do.
AUTOMATON_GENESIS_PROMPT="Keep a running summary of the news in WORKLOG.md. Fetch headlines once an hour, note what changed since last time, and flag anything that contradicts what you wrote earlier."

# Optional one-time message the agent reads on its first run only.
# AUTOMATON_CREATOR_MESSAGE="Start small. Tell me what you need."

# ─── Inference ────────────────────────────────────────────────────

# Any Ollama model that supports tool calling. On CPU, 7-8B at Q4 is the
# practical ceiling; below that, tool calls get unreliable.
#   qwen2.5:7b      solid tool calling, ~4.7GB          (default)
#   llama3.1:8b     good general model, ~4.9GB
#   qwen2.5:14b     noticeably better, ~9GB, slow on CPU
#   qwen2.5:32b     good, needs a GPU to be usable
AUTOMATON_LOCAL_MODEL=qwen2.5:7b

# The agent's system prompt is long — measured at ~11,400 tokens on a real
# boot. Too small a context silently truncates it, and the first thing lost is
# the constitution at the front. 32k leaves room for the conversation to grow.
# Lower it only if you are short on RAM; raise it if you use a bigger model.
OLLAMA_CONTEXT_LENGTH=32768

# How long to wait for the model to be pulled and served on first boot.
AUTOMATON_INFERENCE_WAIT_SECONDS=900

# ─── Donations to you, in Monero ──────────────────────────────────

# Donations are ON by default and go to the address built into this fork
# (see DEFAULT_CREATOR_MONERO_ADDRESS in src/local/monero/config.ts).
#
# Set this to your own address to be the recipient. Setting it does three
# things: gives the agent its own wallet, adds the donation tools, and fixes
# the destination. The agent chooses how much; it cannot choose who.
# AUTOMATON_CREATOR_MONERO_ADDRESS=4...your address...

# Turn the whole donation system off — no wallet daemon, no donation tools.
# AUTOMATON_DONATIONS=off

# The share of income the agent sends when it does not pick a number itself.
AUTOMATON_DONATION_SHARE_PERCENT=1

# The range it is allowed to pick within. A cap you are comfortable with
# matters more than the default — this is the number that binds.
AUTOMATON_DONATION_MIN_SHARE_PERCENT=0
AUTOMATON_DONATION_MAX_SHARE_PERCENT=10

# Hard limits, in XMR. Enforced in code, not in the prompt.
AUTOMATON_DONATION_MIN_XMR=0.001
AUTOMATON_DONATION_MAX_PER_TX_XMR=1
AUTOMATON_DONATION_MAX_PER_DAY_XMR=5
# Balance the agent never spends below, so donating cannot leave it unable to
# pay for something it needs.
AUTOMATON_DONATION_RESERVE_XMR=0
AUTOMATON_DONATION_COOLDOWN_MINUTES=60

# Remote Monero node the wallet syncs against. Running your own is the private
# option; a public node sees your IP and which blocks you ask for.
MONERO_DAEMON_ADDRESS=node.monerodevs.org:18089

# Use stagenet to test the donation flow with worthless coins first. Strongly
# recommended before pointing this at a mainnet address.
#   mainnet | stagenet | testnet
MONERO_NETWORK=mainnet

# Encrypts the wallet file on disk. Empty means unencrypted.
AUTOMATON_MONERO_WALLET_PASSWORD=

# ─── Behaviour ────────────────────────────────────────────────────

# Restore the cloud-only tools (sandboxes, domains, credits, replication).
# Only useful if you have separately provisioned a Conway API key.
# AUTOMATON_LOCAL_ALLOW_CLOUD_TOOLS=0
